# `make init`이 이 파일을 .env로 복사하고 CHANGE_ME 값을 무작위 값으로 채운다.
# .env는 커밋하지 않는다.

# ── Airflow ─────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME

# ── 메타 DB (Airflow 메타 + Metabase 앱 DB) ─
META_DB_USER=airflow
META_DB_PASSWORD=CHANGE_ME
METABASE_DB_PASSWORD=CHANGE_ME

# ── 웨어하우스 ──────────────────────────
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=CHANGE_ME
BI_READER_PASSWORD=CHANGE_ME

# ── 랜딩 존 (SeaweedFS S3) ─────────────
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ── 외부 API 키 (직접 발급해 채운다) ──────
KMA_SERVICE_KEY=
SEOUL_OPENDATA_KEY=
AIRKOREA_SERVICE_KEY=
